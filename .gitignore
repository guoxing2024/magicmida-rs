# Rust build artifacts (at any workspace depth)
target/
.cargo-target/

# Local toolchain directory (recreated by rustup when RUSTUP_HOME is repo-local)
.rustup-local/

# Local agent / session noise (never product)
bash_events/
conversations/

# IDE/editor
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# OS files
Thumbs.db
.DS_Store

# Generated by cargo
**/*.rs.bk

# Python environments and caches
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/
*.pyc
*.pyo

# Executables, libraries, dumps, and runtime logs belong in the SHA vault
*.exe
*.dll
*.dmp
*.log
log/
logs/

# Raw binary fixtures are allowed only under crates/**/fixtures and are
# additionally enforced by tools/verify_workspace_hygiene.ps1.
*.bin
!crates/**/fixtures/*.bin
!crates/**/fixtures/**/*.bin

# Temporary / audit reports
SESSION_REPORT.txt
AUDIT_REPORT.md
_ran.flag
build.bat
.hermes-tmp.*
CLAUDE.md
scylla_hide.ini
run_unpack.bat
unpack_*.log

# Agent work-order process artifacts (2026-08 purification: these belong to
# the session workflow, never to the repository)
WORK_ORDER*.md
WORK_ORDERS_*.md
HANDOFF_PROMPT*.md
evidence_staging/

# Generated by tests / local evidence (not source of truth)
dependency_boundary.json
pe_purity_boundary.json
validation_summary.json
cargo_test.txt

# Reference materials (copyright risk - do not upload)
reference/
.hermes/
.freebuff/
